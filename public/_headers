# Nested paths need explicit rules — CF Pages `*` does not cross `/`
/images/brand-mark.webp
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

/images/*/*
  Cache-Control: public, max-age=31536000, immutable

/images/*/*/*
  Cache-Control: public, max-age=31536000, immutable

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=604800

/favicon-*.png
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/android-chrome-*.png
  Cache-Control: public, max-age=604800

/site.webmanifest
  Cache-Control: public, max-age=86400

/llms.txt
  Cache-Control: public, max-age=3600

/llms-es.txt
  Cache-Control: public, max-age=3600

/enterprise-profile.json
  Cache-Control: public, max-age=3600

/ai-plugin.json
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600
